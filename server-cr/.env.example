PORT=3000

# Optional: require this key in X-Service-Key header on all requests (except /health)
CR_SERVICE_KEY=

# Proxy URL — required for all account checks
# Supports {session} placeholder for per-account sticky IPs
# Supports _country-XX for geo rotation
PROXY_URL=http://USERNAME:PASSWORD_country-us@PROXY_HOST:1111

# Optional: comma-separated country codes to rotate through
# PROXY_COUNTRIES=us,gb,ca,au,de,fr,jp,sg,nl,br,mx,kr,it,es

# Max concurrent account checks (1-20)
CONCURRENCY=5
